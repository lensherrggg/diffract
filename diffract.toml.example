# diffRact 配置模板：复制为 diffract.toml（或使用 -c 指定）后按需修改。
# 相对路径按本配置文件所在目录解析。

[similarity]
window = 5
weight_text = 0.6
weight_semantic = 0.4
threshold_modified = 0.75
threshold_suspected = 0.45
text_candidate_threshold = 0.30

[model]
path = "models/model.onnx"
tokenizer_path = "models/tokenizer.json"
max_seq_len = 512
enabled = true
# true：模型不可用时直接报错；false：自动退化为纯文本匹配。
required = false
output_name = "last_hidden_state"
# mean / cls 用于 3D 输出 [batch, seq, dim]；model 用于 2D 输出 [batch, dim]。
pooling = "mean"
# 0 表示按模型输出自动推断。
dim = 768
batch_size = 8
input_ids_name = "input_ids"
attention_mask_name = "attention_mask"

[diff]
context_chars = 80

[xlsx]
# 省略 header_row 时自动识别；0 表示无表头；填 n 固定第 n 行。
# header_row = 1
# 1 基行键列，例如 [1] 表示 A 列；空表示按整行内容对齐。
key_columns = []
# value / formula / both
compare_mode = "value"
row_window = 10
col_window = 3
# 首版 Excel 引擎不加载语义模型。
semantic_enabled = false
max_iterations = 5
ignore_empty_rows = true

[log]
level = "info"
# 省略 path 或注释掉下一行则不写日志。
# path = "diffract.log"
